# Server Port
PORT=5000

# MongoDB Connection URI (Paste your MongoDB Atlas Connection String here)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/coin-flip-game?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/coin-flip-game?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=30d

# Allowed Client Origin(s) for CORS
CLIENT_ORIGIN=http://localhost:5173

# Node Environment
NODE_ENV=development
